{
  // Сайт «Таро» на Cloudflare Workers: пока только статика (прототип и колода), сервер добавим позже.
  "name": "tarot",
  "compatibility_date": "2026-09-01",

  // Адрес сайта. custom_domain создаёт привязку и DNS-запись сам при деплое,
  // поэтому запись tarot вручную в DNS создавать НЕ нужно (иначе деплой выдаст ошибку).
  "routes": [{ "pattern": "tarot.fixtorllc.com", "custom_domain": true }],

  // Второй публичный адрес (*.workers.dev) и превью-адреса не нужны.
  "workers_dev": false,
  "preview_urls": false,

  // Раздаём собранную папку dist (её делает tools/build_site.sh).
  "assets": { "directory": "./dist" },

  "observability": { "enabled": true }
}
